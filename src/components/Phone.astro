---
// Device frame. Screens are passed in as the default slot and fill the display.
interface Props {
  label: string;
  class?: string;
}
const { label, class: className } = Astro.props;
---

<figure class:list={['phone', className]} aria-label={label}>
  <div class="display">
    <div class="island" aria-hidden="true"></div>
    <slot />
  </div>
</figure>

<style>
  .phone {
    --w: 300px;
    margin: 0;
    width: var(--w);
    aspect-ratio: 300 / 620;
    padding: 11px;
    border-radius: 50px;
    background: var(--phone-shell);
    box-shadow:
      inset 0 0 0 1.5px color-mix(in srgb, #fff 16%, transparent),
      0 1px 0 1px color-mix(in srgb, #000 30%, transparent),
      0 40px 60px -30px color-mix(in srgb, #1c1f24 45%, transparent),
      0 18px 30px -18px color-mix(in srgb, #1c1f24 35%, transparent);
    position: relative;
    flex: none;
  }

  .display {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 40px;
    overflow: hidden;
    background: #fff;
    isolation: isolate;
  }

  .island {
    position: absolute;
    top: 10px;
    left: 50%;
    width: 86px;
    height: 25px;
    margin-left: -43px;
    border-radius: 20px;
    background: #000;
    z-index: 20;
  }
</style>
