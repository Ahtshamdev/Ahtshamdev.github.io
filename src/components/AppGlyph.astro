---
interface Props {
  slug: string;
  size?: number;
}
const { slug, size = 28 } = Astro.props;
---

<svg viewBox="0 0 32 32" width={size} height={size} aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
  {slug === 'tidewell' && (
    <>
      <path d="M16 4.5c4.8 5.8 8 10.2 8 14a8 8 0 0 1-16 0c0-3.8 3.2-8.2 8-14z" fill="currentColor" stroke="none" opacity="0.95" />
      <path d="M11.5 19.5c1.5 1.4 3 1.4 4.5 0s3-1.4 4.5 0" stroke="#0e7c86" />
    </>
  )}
  {slug === 'kilo' && (
    <>
      <path d="M7 11h18l-1.6 14.2a2 2 0 0 1-2 1.8H10.6a2 2 0 0 1-2-1.8z" fill="currentColor" stroke="none" />
      <path d="M12 11V9a4 4 0 0 1 8 0v2" />
      <path d="M17 15l-3.2 4.6H18L15 24" stroke="#e0482b" stroke-width="2" />
    </>
  )}
  {slug === 'dose' && (
    <>
      <rect x="5" y="11" width="22" height="10" rx="5" transform="rotate(-40 16 16)" fill="currentColor" stroke="none" />
      <path d="M13.2 12.6l6.1 7.2" stroke="#6b4ee6" />
    </>
  )}
  {slug === 'ledger' && (
    <>
      <circle cx="16" cy="16" r="10" />
      <path d="M16 6a10 10 0 0 1 8.7 15L16 16z" fill="currentColor" stroke="none" />
    </>
  )}
</svg>
