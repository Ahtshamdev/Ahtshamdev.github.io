---
import Base from '../layouts/Base.astro';
import { profile, experience, allWork, capabilities, education } from '../data/site';
import { url } from '../lib/url';
---

<Base title="Résumé" description={`Résumé of ${profile.name}, ${profile.role.toLowerCase()}.`}>
  <div class="wrap page">
    <div class="tools">
      <a class="link muted" href={url()}>Back to portfolio</a>
      <button class="btn btn-solid" type="button" data-print>Save as PDF</button>
    </div>

    <article class="sheet">
      <header class="r-head">
        <div>
          <h1>{profile.name}</h1>
          <p class="r-role">{profile.role}</p>
        </div>
        <ul class="r-contact" role="list">
          <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
          <li><a href={profile.github}>{profile.github.replace('https://', '')}</a></li>
          <li>{profile.location}</li>
        </ul>
      </header>

      <section>
        <h2>Summary</h2>
        <p>{profile.intro}</p>
      </section>

      <section>
        <h2>Experience</h2>
        {experience.map((r) => (
          <div class="r-item">
            <div class="r-line">
              <h3>{r.title}, {r.company}</h3>
              <p class="r-date num">{r.period}</p>
            </div>
            <p>{r.body}</p>
          </div>
        ))}
      </section>

      <section>
        <h2>Selected projects</h2>
        {allWork.map((p) => (
          <div class="r-item">
            <div class="r-line">
              <h3>{p.name}, {p.tagline.toLowerCase()}</h3>
              <p class="r-date num">{p.year}</p>
            </div>
            <p>{p.metrics.map((m) => `${m.value} ${m.label}`).join('; ')}. {p.stack.join(', ')}.</p>
          </div>
        ))}
      </section>

      <section>
        <h2>Skills</h2>
        {capabilities.map((c) => (
          <p class="r-skill"><strong>{c.title}.</strong> {c.body}</p>
        ))}
      </section>

      <section>
        <h2>Education</h2>
        <p>{education}</p>
      </section>
    </article>
  </div>
</Base>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>

<style>
  .page {
    padding-block: 2.5rem 5rem;
    max-width: 920px;
  }

  .tools {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    font-size: var(--step--1);
  }

  .sheet {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    padding: clamp(1.5rem, 5vw, 3.5rem);
    font-size: 0.97rem;
    line-height: 1.5;
  }

  .r-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 2px solid var(--ink);
  }

  h1 {
    font-size: var(--step-3);
    letter-spacing: -0.04em;
  }

  .r-role {
    font-size: var(--step-1);
    color: var(--muted);
    margin-top: 0.25rem;
  }

  .r-contact {
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: right;
    font-size: var(--step--1);
    color: var(--muted);
    display: grid;
    gap: 0.15rem;
    align-content: end;
  }

  .r-contact a {
    text-decoration: none;
  }

  section {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 0 2rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  section:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  section > :not(h2) {
    grid-column: 2;
  }

  h2 {
    grid-row: 1 / span 10;
    font-size: var(--step-0);
    letter-spacing: -0.01em;
  }

  .r-item + .r-item {
    margin-top: 1rem;
  }

  .r-line {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
  }

  h3 {
    font-size: var(--step-0);
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .r-date {
    color: var(--muted);
    font-size: var(--step--1);
    white-space: nowrap;
  }

  .r-item > p,
  .r-skill {
    color: var(--muted);
  }

  .r-skill + .r-skill {
    margin-top: 0.5rem;
  }

  @media (max-width: 640px) {
    section {
      grid-template-columns: minmax(0, 1fr);
    }

    section > :not(h2) {
      grid-column: 1;
    }

    h2 {
      grid-row: auto;
      margin-bottom: 0.5rem;
    }

    .r-contact {
      text-align: left;
    }

    .r-line {
      flex-direction: column;
      gap: 0;
    }
  }

  @media print {
    :global(.site-header),
    :global(.site-footer),
    :global(.skip),
    .tools {
      display: none !important;
    }

    :global(body) {
      background: #fff;
      color: #000;
      font-size: 10pt;
    }

    .page {
      padding: 0;
      max-width: none;
    }

    .sheet {
      border: 0;
      padding: 0;
      background: #fff;
      font-size: 9.5pt;
    }

    section {
      break-inside: avoid;
      padding-block: 0.9rem;
    }

    .r-item {
      break-inside: avoid;
    }
  }

  @page {
    margin: 14mm 16mm;
  }
</style>
